---
import type { CollectionEntry } from 'astro:content';
import { formatPublicationDate } from '../lib/dates';
import { publicationPath } from '../lib/publications';
import type { Locale } from '../lib/i18n/languages';
import { t, type MessageKey } from '../lib/i18n/messages';

interface Props {
  entry: CollectionEntry<'research'> | CollectionEntry<'articles'> | CollectionEntry<'essays'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const { title, description, publishedAt, readingTime, featured } = entry.data;

const typeKey: MessageKey =
  entry.data.contentType === 'research'
    ? 'publication.type.research'
    : entry.data.contentType === 'essay'
      ? 'publication.type.essay'
      : 'publication.type.article';
const typeLabel = t(locale, typeKey);
---

<article class="library-publication-card">
  <a href={publicationPath(entry, locale)} class="library-featured-card">
    {featured && <p class="library-featured-badge">{t(locale, 'publication.featured')} · {typeLabel}</p>}
    {!featured && <p class="library-featured-badge">{typeLabel}</p>}
    <h2 class="library-featured-title">{title}</h2>
    <p class="library-featured-desc">{description}</p>
    <p class="library-featured-meta">
      <span>{formatPublicationDate(publishedAt, locale)}</span>
      {readingTime != null && (
        <span>
          {readingTime} {t(locale, 'publication.readingMinutes')}
        </span>
      )}
    </p>
    <p class="library-featured-cta">{t(locale, 'publication.readCta')}</p>
  </a>
</article>
