---
import type { Locale } from '../lib/i18n/languages';
import { contentSectionPath, localePath } from '../lib/i18n/paths';
import { t } from '../lib/i18n/messages';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  minimal?: boolean;
}

const { locale, minimal = false } = Astro.props;
const currentPath = Astro.url.pathname;

const nav = [
  { href: contentSectionPath(locale, 'research'), labelKey: 'nav.research' as const },
  { href: contentSectionPath(locale, 'essays'), labelKey: 'nav.essays' as const },
  { href: contentSectionPath(locale, 'articles'), labelKey: 'nav.articles' as const },
];
---

<header
  class:list={[
    'border-b',
    minimal ? 'border-[var(--research-line,#e8e4dc)] bg-[var(--research-paper,#faf9f7)]/95' : 'border-neutral-200',
  ]}
>
  <div
    class:list={[
      'header-inner mx-auto px-4',
      minimal ? 'header-inner--editorial max-w-6xl py-3' : 'max-w-3xl py-4 flex flex-wrap items-center justify-between gap-4',
    ]}
  >
    <a
      href={localePath(locale, '/')}
      class:list={[
        'header-brand transition-colors',
        minimal
          ? 'text-[var(--research-ink)] hover:text-[var(--research-ink-muted)]'
          : 'tracking-tight text-lg font-medium text-neutral-900 hover:text-neutral-600',
      ]}
    >
      <span class:list={[minimal ? 'header-brand-title' : '']}>{t(locale, 'site.name')}</span>
      {
        minimal && (
          <span class="header-brand-tagline">{t(locale, 'site.tagline')}</span>
        )
      }
    </a>
    <div class="header-actions">
      <nav
        class:list={[
          'header-nav flex flex-wrap gap-5 text-sm',
          minimal ? 'text-[var(--research-ink-soft)]' : 'text-neutral-500',
        ]}
        aria-label={t(locale, 'nav.aria')}
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                'transition-colors shrink-0',
                minimal ? 'hover:text-[var(--research-ink)]' : 'hover:text-neutral-900',
              ]}
            >
              {t(locale, item.labelKey)}
            </a>
          ))
        }
      </nav>
      <LanguageSwitcher locale={locale} currentPath={currentPath} minimal={minimal} />
    </div>
  </div>
</header>

<style>
  .header-inner--editorial {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 2rem;
    row-gap: 0.75rem;
  }

  .header-inner--editorial .header-brand {
    display: block;
    text-decoration: none;
    max-width: none;
    width: 100%;
    min-width: 0;
  }

  .header-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.625rem;
    justify-self: end;
    align-self: center;
  }

  .header-inner--editorial .header-nav {
    justify-self: end;
    align-self: center;
    padding-top: 0.125rem;
  }

  .header-brand-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .header-brand-tagline {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--research-ink-soft, #7a736c);
    letter-spacing: 0.01em;
    max-width: none;
  }

  @media (max-width: 767px) {
    .header-inner--editorial {
      grid-template-columns: 1fr;
    }

    .header-actions {
      align-items: flex-start;
      justify-self: start;
      align-self: start;
    }

    .header-inner--editorial .header-nav {
      justify-self: start;
      align-self: start;
      padding-top: 0;
    }
  }
</style>
