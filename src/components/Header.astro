---
import { SITE_NAME, SITE_TAGLINE } from '../lib/site';

interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;

const nav = [
  { href: '/research', label: 'Исследования' },
  { href: '/essays', label: 'Эссе' },
  { href: '/articles', label: 'Статьи' },
];
---

<header
  class:list={[
    'border-b',
    minimal ? 'border-[var(--research-line,#e8e4dc)] bg-[var(--research-paper,#faf9f7)]/95' : 'border-neutral-200',
  ]}
>
  <div
    class:list={[
      'header-inner mx-auto px-4',
      minimal ? 'header-inner--editorial max-w-6xl py-3' : 'max-w-3xl py-4 flex flex-wrap items-center justify-between gap-4',
    ]}
  >
    <a
      href="/"
      class:list={[
        'header-brand transition-colors',
        minimal
          ? 'text-[var(--research-ink)] hover:text-[var(--research-ink-muted)]'
          : 'tracking-tight text-lg font-medium text-neutral-900 hover:text-neutral-600',
      ]}
    >
      <span class:list={[minimal ? 'header-brand-title' : '']}>
        {SITE_NAME}
      </span>
      {
        minimal && (
          <span class="header-brand-tagline">{SITE_TAGLINE}</span>
        )
      }
    </a>
    <nav
      class:list={[
        'header-nav flex flex-wrap gap-5 text-sm',
        minimal ? 'text-[var(--research-ink-soft)]' : 'text-neutral-500',
      ]}
      aria-label="Основная навигация"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'transition-colors shrink-0',
              minimal ? 'hover:text-[var(--research-ink)]' : 'hover:text-neutral-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  /* TW-CONTENT-003A-FIX-HEADER — brand uses available row width, not fixed 28rem */
  .header-inner--editorial {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: 2rem;
    row-gap: 0.75rem;
  }

  .header-inner--editorial .header-brand {
    display: block;
    text-decoration: none;
    max-width: none;
    width: 100%;
    min-width: 0;
  }

  .header-inner--editorial .header-nav {
    justify-self: end;
    align-self: center;
    padding-top: 0.125rem;
  }

  .header-brand-title {
    display: block;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .header-brand-tagline {
    display: block;
    margin-top: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--research-ink-soft, #7a736c);
    letter-spacing: 0.01em;
    max-width: none;
  }

  @media (max-width: 767px) {
    .header-inner--editorial {
      grid-template-columns: 1fr;
    }

    .header-inner--editorial .header-nav {
      justify-self: start;
      align-self: start;
      padding-top: 0;
    }
  }
</style>
