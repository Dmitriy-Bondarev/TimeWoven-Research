---
import { formatPublicationDate } from '../lib/dates';
import type { Locale } from '../lib/i18n/languages';
import { t } from '../lib/i18n/messages';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  authorName?: string;
  publishedAt: Date;
  readingTime?: number;
  /** Defaults to research category label. */
  category?: string;
}

const { locale, title, description, authorName, publishedAt, readingTime, category } = Astro.props;
const categoryLabel = category ?? t(locale, 'research.hero.category');
---

<header class="research-hero">
  <div class="research-hero-inner">
    <p class="research-hero-category">{categoryLabel}</p>
    <h1 class="research-hero-title">{title}</h1>
    <p class="research-hero-description">{description}</p>
    <dl class="research-hero-meta">
      {
        authorName && (
          <div class="research-hero-meta-item">
            <dt>{t(locale, 'research.hero.author')}</dt>
            <dd>{authorName}</dd>
          </div>
        )
      }
      <div class="research-hero-meta-item">
        <dt>{t(locale, 'research.hero.published')}</dt>
        <dd>
          <time datetime={publishedAt.toISOString()}>{formatPublicationDate(publishedAt, locale)}</time>
        </dd>
      </div>
      {
        readingTime != null && (
          <div class="research-hero-meta-item">
            <dt>{t(locale, 'research.hero.reading')}</dt>
            <dd>
              {readingTime} {t(locale, 'research.hero.readingMinutes')}
            </dd>
          </div>
        )
      }
    </dl>
    <div class="research-hero-divider" aria-hidden="true"></div>
  </div>
</header>
