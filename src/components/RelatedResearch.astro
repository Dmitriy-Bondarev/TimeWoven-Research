---
import type { CollectionEntry } from 'astro:content';
import { formatPublicationDate } from '../lib/dates';
import { publicationPath } from '../lib/publications';
import type { Locale } from '../lib/i18n/languages';
import { t } from '../lib/i18n/messages';

interface Props {
  locale: Locale;
  currentSlug: string;
  items?: CollectionEntry<'research'>[];
}

const { locale, currentSlug, items = [] } = Astro.props;
const related = items.filter((e) => e.data.slug !== currentSlug).slice(0, 3);
---

<section class="research-related">
  <h2 class="research-related-title">{t(locale, 'research.related.title')}</h2>
  {
    related.length > 0 ? (
      <ul class="research-related-list">
        {related.map((entry) => (
          <li class="research-related-item">
            <a href={publicationPath(entry, locale)} class="research-related-link">
              <span class="research-related-link-title">{entry.data.title}</span>
              <span class="research-related-link-meta">
                {formatPublicationDate(entry.data.publishedAt, locale)}
                {entry.data.readingTime != null && (
                  <span>
                    {' '}
                    · {entry.data.readingTime} {t(locale, 'research.hero.readingMinutes')}
                  </span>
                )}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="research-related-empty">{t(locale, 'research.related.empty')}</p>
    )
  }
</section>
