---
import type { Locale } from '../lib/i18n/languages';
import { contentSectionPath, localePath } from '../lib/i18n/paths';
import { t } from '../lib/i18n/messages';

interface Props {
  locale: Locale;
  variant?: 'default' | 'library';
}

const { locale, variant = 'default' } = Astro.props;
const isLibrary = variant === 'library';
---

<footer
  class:list={[
    'mt-auto border-t',
    isLibrary ? 'library-footer border-[var(--library-line,#e8e4dc)]' : 'border-neutral-200',
  ]}
>
  <div
    class:list={[
      'mx-auto px-4 py-8',
      isLibrary ? 'library-footer-inner max-w-[42rem]' : 'max-w-3xl py-6 text-sm text-neutral-500',
    ]}
  >
    {
      isLibrary ? (
        <>
          <p class="library-footer-brand">{t(locale, 'site.name')}</p>
          <nav class="library-footer-nav" aria-label={t(locale, 'footer.sectionsAria')}>
            <a href={localePath(locale, '/')}>{t(locale, 'footer.home')}</a>
            <a href={contentSectionPath(locale, 'research')}>{t(locale, 'nav.research')}</a>
            <a href={contentSectionPath(locale, 'essays')}>{t(locale, 'nav.essays')}</a>
            <a href={contentSectionPath(locale, 'articles')}>{t(locale, 'nav.articles')}</a>
          </nav>
        </>
      ) : (
        <p>{t(locale, 'site.name')}</p>
      )
    }
  </div>
</footer>
