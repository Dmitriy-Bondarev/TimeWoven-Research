---
import BaseLayout from './BaseLayout.astro';
import ResearchHero from '../components/ResearchHero.astro';
import AuthorCard from '../components/AuthorCard.astro';
import ResearchCTA from '../components/ResearchCTA.astro';
import RelatedResearch from '../components/RelatedResearch.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getResearch, publicationPath } from '../lib/publications';
import { getAuthorById } from '../lib/authors';
import type { Locale } from '../lib/i18n/languages';
import { t } from '../lib/i18n/messages';

interface Props {
  entry: CollectionEntry<'research'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const {
  title,
  author: authorId,
  publishedAt,
  readingTime,
  seoTitle,
  seoDescription,
  ogImage,
} = entry.data;

const pageTitle = seoTitle ?? title;
const description = seoDescription ?? entry.data.description;
const canonicalPath = publicationPath(entry, locale);
const author = await getAuthorById(authorId);
const allResearch = await getResearch(locale);
const { Content } = await render(entry);
---

<BaseLayout
  locale={locale}
  title={`${pageTitle} · ${t(locale, 'site.name')}`}
  description={description}
  canonicalPath={canonicalPath}
  ogType="article"
  ogTitle={pageTitle}
  ogDescription={description}
  ogImage={ogImage}
  surface="research"
>
  <article class="research-page research-page--article tw-article">
    <ResearchHero
      locale={locale}
      title={title}
      description={description}
      authorName={author?.data.name}
      publishedAt={publishedAt}
      readingTime={readingTime}
    />

    <div class="research-article-shell">
      <div class="research-prose">
        <Content />
      </div>
    </div>

    <footer class="research-page-footer">
      {author && <AuthorCard author={author} locale={locale} />}
      <ResearchCTA locale={locale} />
      <RelatedResearch locale={locale} currentSlug={entry.data.slug} items={allResearch} />
    </footer>
  </article>
</BaseLayout>
