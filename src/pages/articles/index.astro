---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../lib/site';
import LibraryEmptyState from '../../components/LibraryEmptyState.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { getArticles } from '../../lib/publications';

const articles = await getArticles();
---

<BaseLayout
  title={`Статьи · ${SITE_NAME}`}
  description="Короткие материалы о семейной памяти — заметки и разборы, которые дополняют библиотеку."
  canonicalPath="/articles"
  surface="library"
>
  <div class="library-page">
    <header class="library-catalog-header">
      <p class="library-eyebrow">Раздел</p>
      <h1 class="library-hero-title library-catalog-header-title">Статьи</h1>
      <p class="library-hero-lead library-catalog-header-lead">
        Короткие редакционные публикации: заметки, разборы и практические наблюдения, которые
        дополняют нашу библиотеку.
      </p>
    </header>

    <section class="library-section">
      {
        articles.length > 0 ? (
          <ul class="library-catalog-list">
            {articles.map((entry) => (
              <li>
                <PublicationCard entry={entry} />
              </li>
            ))}
          </ul>
        ) : (
          <LibraryEmptyState
            message="Раздел находится в подготовке."
            note={`Здесь будут материалы — удобные для чтения за один присест.

Пока тексты готовятся, вы можете почитать раздел «Исследования» или вернуться на главную.`}
          />
        )
      }
      <p class="library-catalog-back">
        <a href="/research">Исследования</a>
        <span aria-hidden="true"> · </span>
        <a href="/">Главная библиотеки</a>
      </p>
    </section>
  </div>
</BaseLayout>
