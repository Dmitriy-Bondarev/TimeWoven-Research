---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../lib/site';
import { getResearch } from '../../lib/publications';
import { formatPublicationDate } from '../../lib/dates';
import { publicationPath } from '../../lib/publications';

const research = await getResearch();
---

<BaseLayout
  title={`Исследования · ${SITE_NAME}`}
  description="Исследования о семейной памяти, поколениях и межпоколенческой преемственности."
  canonicalPath="/research"
  surface="library"
>
  <div class="library-page">
    <header class="library-catalog-header">
      <p class="library-eyebrow">Раздел</p>
      <h1 class="library-hero-title library-catalog-header-title">Исследования</h1>
      <p class="library-hero-lead library-catalog-header-lead">
        Развёрнутые тексты о том, как семейная память устроена, передаётся между поколениями и
        почему исчезает — с опорой на социологию, историю и живые семейные воспоминания.
      </p>
    </header>

    <section class="library-section">
      {
        research.length > 0 ? (
          <ul class="library-catalog-list">
            {research.map((entry) => (
              <li>
                <a href={publicationPath(entry)} class="library-featured-card">
                  {entry.data.featured && (
                    <p class="library-featured-badge">Избранное</p>
                  )}
                  <h2 class="library-featured-title">{entry.data.title}</h2>
                  <p class="library-featured-desc">{entry.data.description}</p>
                  <p class="library-featured-meta">
                    <span>{formatPublicationDate(entry.data.publishedAt)}</span>
                    {entry.data.readingTime != null && (
                      <span>{entry.data.readingTime} мин чтения</span>
                    )}
                  </p>
                  <p class="library-featured-cta">Читать →</p>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="library-empty-note">
            Первые исследования появятся здесь. Пока можно вернуться на
            <a href="/">главную страницу библиотеки</a>.
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
