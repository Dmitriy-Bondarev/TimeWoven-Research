---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME } from '../lib/site';
import { getFeaturedResearch } from '../lib/publications';
import { formatPublicationDate } from '../lib/dates';
import { publicationPath } from '../lib/publications';

const featured = await getFeaturedResearch();
const lead = featured[0];
---

<BaseLayout
  title={`${SITE_NAME} — библиотека о семейной памяти`}
  description="Исследования и тексты о том, как семейная память передаётся между поколениями — и почему она исчезает."
  surface="library"
>
  <div class="library-page">
    <section class="library-hero">
      <div class="library-hero-inner">
        <p class="library-eyebrow">{SITE_NAME}</p>
        <h1 class="library-hero-title">Библиотека проекта TimeWoven</h1>
        <p class="library-hero-lead">
          Здесь собраны исследования и публикации, связанные с сохранением памяти и историей семей.
        </p>
        <p class="library-hero-purpose">
          Материалы предназначены для вдумчивого чтения, размышлений и создания новых смыслов.
        </p>
      </div>
    </section>

    <section class="library-mission" aria-labelledby="library-mission-title">
      <div class="library-mission-inner">
        <h2 id="library-mission-title" class="library-mission-title">Для чего мы это делаем?</h2>
        <p class="library-mission-text">
          Семейная память — это не только архив фотографий или сформированная родословная. Это то,
          как мы понимаем и осознаём, откуда мы пришли и что и как мы можем передать дальше.
        </p>
        <p class="library-mission-text">
          Проект помогает сохранять память семьи, а материалы библиотеки дают возможность
          взглянуть на обычные вещи по-новому.
        </p>
      </div>
    </section>

    <section class="library-section" aria-labelledby="library-sections-title">
      <h2 id="library-sections-title" class="library-section-title">Разделы</h2>
      <ul class="library-sections-grid">
        <li>
          <a href="/research" class="library-section-card">
            <span class="library-section-card-label">Исследования</span>
            <span class="library-section-card-desc">
              Развёрнутые тексты о том, как семейная память устроена, передаётся между поколениями
              и почему исчезает — с опорой на социологию, историю и живые семейные воспоминания.
            </span>
            <span class="library-section-card-link">Открыть раздел →</span>
          </a>
        </li>
        <li>
          <a href="/essays" class="library-section-card">
            <span class="library-section-card-label">Эссе</span>
            <span class="library-section-card-desc">
              Размышляем о семье и памяти. Бережно и со смыслом.
            </span>
            <span class="library-section-card-link">Открыть раздел →</span>
          </a>
        </li>
        <li>
          <a href="/articles" class="library-section-card">
            <span class="library-section-card-label">Статьи</span>
            <span class="library-section-card-desc">
              Короткие редакционные публикации: заметки, разборы и практические наблюдения,
              которые дополняют нашу библиотеку.
            </span>
            <span class="library-section-card-link">Открыть раздел →</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="library-section">
      <div class="library-section-header">
        <h2 class="library-section-title">Избранное исследование</h2>
        <a href="/research" class="library-section-link">Все исследования</a>
      </div>

      {
        lead ? (
          <a href={publicationPath(lead)} class="library-featured-card">
            <p class="library-featured-badge">Избранное · Исследование</p>
            <h3 class="library-featured-title">{lead.data.title}</h3>
            <p class="library-featured-desc">{lead.data.description}</p>
            <p class="library-featured-meta">
              <span>{formatPublicationDate(lead.data.publishedAt)}</span>
              {lead.data.readingTime != null && (
                <span>{lead.data.readingTime} мин чтения</span>
              )}
            </p>
            <p class="library-featured-cta">Читать исследование →</p>
          </a>
        ) : (
          <p class="library-empty-note">Исследования готовятся к публикации.</p>
        )
      }
    </section>
  </div>
</BaseLayout>
